flowchart TB

  subgraph P0["EXISTING — P0 (do not modify)"]
    direction TB
    E_CONF["buildConflicts()"]
    E_RULES["evaluateRules()"]
    E_RANK["rankFixes()"]
    E_BUNDLE["buildBundle()"]
    D_SEED["seed/citizens.ts"]
    D_RULES["rules/*.ts"]
    S_FIX["Screen 5 · Fix queue"]
    S_REC["Screen 3 · Record"]
    S_REAL["Screen 8 · Honesty page"]
    ADAPT["mock/walletAdapter.ts"]
  end

  subgraph P1A["P1a — highest value, lowest risk"]
    direction TB
    CASCADE["engine/cascade.ts<br/>runs buildConflicts twice, diffs"]
    S_CASC["Fix queue expansion<br/>'what happens if I do this'"]
    LINKPROBE["mock/linkage/*.ts<br/>same shape as walletAdapter"]
    S_LINK["Screen 9 · Linkage map<br/>mandatory / conditional / voluntary"]
  end

  subgraph P1B["P1b — drop whole wave if behind"]
    direction TB
    TRACK["engine/tracking.ts<br/>daysElapsed · isOverdue"]
    RCODES["seed/reasonCodes.ts"]
    APPEAL["appeal draft<br/>template + facts"]
    S_TRACK["Screen 12 · Tracker"]
  end

  subgraph P1C["P1c — one hour, never cut"]
    direction TB
    SPEC["/spec/linkage-match.yaml<br/>OpenAPI 3.1 · match not retrieve"]
    MOCKSRV["/spec/mock-server<br/>reference implementation"]
    SPECDOC["/spec/README.md<br/>consent model + 3 safeguards"]
  end

  E_CONF --> CASCADE
  D_SEED --> CASCADE
  CASCADE --> S_CASC
  S_FIX --> S_CASC

  ADAPT -.->|"copy interface"| LINKPROBE
  LINKPROBE --> S_LINK
  D_RULES -.->|"citation validator<br/>extends to linkage"| LINKPROBE

  TRACK --> S_TRACK
  RCODES --> S_TRACK
  TRACK --> APPEAL
  APPEAL --> S_TRACK

  SPEC --> MOCKSRV
  SPEC --> SPECDOC
  LINKPROBE -.->|"mock implements<br/>this contract"| SPEC

  LINKPROBE --> S_REAL
  SPEC --> S_REAL
  TRACK --> S_REAL

  classDef done fill:#eceff1,stroke:#607d8b
  classDef high fill:#e8f5e9,stroke:#2e7d32
  classDef mid fill:#fff8e1,stroke:#f9a825
  classDef cheap fill:#e3f2fd,stroke:#1565c0
  class P0 done
  class P1A high
  class P1B mid
  class P1C cheap
